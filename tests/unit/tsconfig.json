        "../../components/apps/paint/raster.ts",
        "../../components/apps/paint/history.ts",
        "../../components/apps/paint/palette.ts",
        "../../components/apps/paint/tools.ts",
        "../../components/apps/solitaire/engine.ts",
        "../../components/apps/minesweeper/engine.ts",
        "../../components/apps/calculator/engine.ts",
        "../../components/apps/calculator/input.ts"
    ]
}
